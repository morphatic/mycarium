[Unit]
Description=Mycarium Server (MQTT persistence + REST API)
After=network.target mosquitto.service

[Service]
Type=simple
User=morphatic
WorkingDirectory=/home/morphatic/mycarium/server
ExecStart=/usr/bin/node dist/index.js
EnvironmentFile=/home/morphatic/mycarium/server/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
