# Database
DATABASE_PATH=./data/mycarium.db

# MQTT broker (mTLS)
MQTT_BROKER_URL=mqtts://mycarium.morphatic.com:8883
MQTT_CA_PATH=/etc/mosquitto/certs/mycarium.morphatic.com/ca.crt
MQTT_CERT_PATH=/etc/mosquitto/certs/mycarium.morphatic.com/persistence-service.crt
MQTT_KEY_PATH=/etc/mosquitto/certs/mycarium.morphatic.com/persistence-service.key

# Certificate authority (for issuing user certs)
CA_CERT_PATH=/etc/mosquitto/certs/mycarium.morphatic.com/ca.crt
CA_KEY_PATH=/etc/mosquitto/certs/mycarium.morphatic.com/ca.key
CA_KEY_PASSWORD=

# API
API_PORT=3000
CORS_ORIGIN=https://mycarium.morphatic.com

# Sessions
SESSION_DURATION_DAYS=30

# Retention
RETENTION_DAYS=90
